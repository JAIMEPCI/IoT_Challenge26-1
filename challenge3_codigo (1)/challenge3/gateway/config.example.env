# Copiar como config.env y completar. NO subir config.env a GitHub.

# Mosquitto local (en la misma Raspberry)
MQTT_LOCAL_HOST=localhost
MQTT_LOCAL_PORT=1883
MQTT_LOCAL_USER=gateway
MQTT_LOCAL_PASS=cambiar_clave_gateway

# Ubidots: token en Ubidots > menú de usuario > API Credentials
UBIDOTS_HOST=industrial.api.ubidots.com
UBIDOTS_PORT=8883
UBIDOTS_TOKEN=BBUS-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base de datos SQLite
DB_PATH=/home/pi/agua/agua.db

# IA generativa (Google AI Studio > Get API key). Verificar el nombre del modelo
# vigente en la documentación de la Gemini API; "gemini-flash-latest" es un alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
IA_PERIODO_S=600
IA_ESPERA_S=60
UBIDOTS_PERIODO_S=300
